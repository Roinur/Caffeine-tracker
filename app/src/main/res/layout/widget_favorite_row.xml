<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_drink_row" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_ripple" android:paddingStart="4dp">
    <ImageView android:id="@+id/widget_drink_image" android:layout_width="30dp" android:layout_height="34dp" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
        <TextView android:id="@+id/widget_drink_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textColor="#E9EDF2"/>
        <TextView android:id="@+id/widget_drink_dose" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" android:textColor="#B4BEC8"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_drink_add" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginStart="2dp" android:padding="4dp" android:importantForAccessibility="no"/>
</LinearLayout>
