<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_background">
    <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" android:importantForAccessibility="no"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="28dp" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center_vertical" android:text="@string/app_name" android:textStyle="bold" android:textSize="11sp" android:textColor="#E9EDF2" android:maxLines="1"/>
            <LinearLayout android:id="@+id/widget_refresh" android:layout_width="56dp" android:layout_height="match_parent" android:gravity="center" android:orientation="horizontal" android:background="@drawable/widget_ripple" android:contentDescription="@string/widget_refresh">
                <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#B4BEC8"/>
                <ImageView android:layout_width="16dp" android:layout_height="16dp" android:layout_marginStart="4dp" android:src="@drawable/widget_refresh" android:importantForAccessibility="no"/>
            </LinearLayout>
            <TextView android:id="@+id/widget_header_undo" android:layout_width="64dp" android:layout_height="match_parent" android:text="@string/widget_undo" android:gravity="center" android:textSize="11sp" android:background="@drawable/widget_ripple" android:visibility="gone"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:id="@+id/widget_metrics" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.42" android:orientation="vertical" android:gravity="center_vertical" android:paddingEnd="8dp" android:background="@drawable/widget_ripple">
                <TextView android:id="@+id/widget_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_now_label" android:textColor="#B4BEC8" android:textSize="11sp"/>
                <TextView android:id="@+id/widget_now" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_dash" android:textColor="#E9EDF2" android:textSize="28sp" android:textStyle="bold" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="18sp" android:autoSizeMaxTextSize="28sp" android:autoSizeStepGranularity="1sp"/>
                <TextView android:id="@+id/widget_evening" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B4BEC8" android:textSize="10sp" android:maxLines="1"/>
                <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#B4BEC8" android:textSize="10sp" android:layout_marginTop="3dp" android:maxLines="1"/>
            </LinearLayout>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.58">
                <ListView android:id="@+id/widget_favorites" android:layout_width="match_parent" android:layout_height="match_parent" android:divider="@android:color/transparent" android:dividerHeight="2dp" android:scrollbars="none" android:clipToPadding="false"/>
                <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="@string/widget_no_favorites" android:textColor="#B4BEC8" android:textSize="11sp"/>
            </FrameLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/widget_footer" android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical" android:orientation="horizontal" android:visibility="invisible">
            <TextView android:id="@+id/widget_status" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="10sp" android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_undo" android:layout_width="64dp" android:layout_height="match_parent" android:text="@string/widget_undo" android:textColor="#F9AA23" android:gravity="center" android:textSize="11sp" android:background="@drawable/widget_ripple"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
